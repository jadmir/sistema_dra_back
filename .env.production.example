# ============================================
# CONFIGURACIÓN DE PRODUCCIÓN - Sistema DRA
# ============================================
# IMPORTANTE: Copiar este archivo como .env
# y actualizar con valores reales de producción
# ============================================

# === APLICACIÓN ===
APP_NAME="Sistema DRA"
APP_ENV=production
APP_KEY=base64:GENERAR_NUEVA_KEY_CON_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://api.dra.gob.pe

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# === LOGGING ===
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# === BASE DE DATOS ===
DB_CONNECTION=mysql
DB_HOST=sistemadra.cj488yc0ibxw.us-east-2.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=sistemaDra
DB_USERNAME=admin
DB_PASSWORD=CAMBIAR_PASSWORD_PRODUCCION

# === SESIONES ===
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.dra.gob.pe
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

# === BROADCASTING ===
BROADCAST_CONNECTION=log

# === FILESYSTEM ===
FILESYSTEM_DISK=s3
# Considerar usar S3 para archivos en producción
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
AWS_BUCKET=dra-sistema-storage
AWS_USE_PATH_STYLE_ENDPOINT=false

# === CACHE ===
CACHE_DRIVER=redis
CACHE_PREFIX=dra_prod

# === QUEUE ===
QUEUE_CONNECTION=redis

# === REDIS ===
REDIS_CLIENT=phpredis
REDIS_HOST=REDIS_HOST_PRODUCCION
REDIS_PASSWORD=REDIS_PASSWORD_PRODUCCION
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# === MEMCACHED (Alternativa) ===
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211

# === MAIL ===
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@dra.gob.pe
MAIL_PASSWORD=MAIL_PASSWORD_PRODUCCION
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@dra.gob.pe"
MAIL_FROM_NAME="${APP_NAME}"

# === JWT AUTHENTICATION ===
JWT_SECRET=GENERAR_SECRETO_FUERTE_ALEATORIO
JWT_TTL=120
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_SHOW_BLACKLIST_EXCEPTION=false

# === SANCTUM ===
SANCTUM_STATEFUL_DOMAINS=app.dra.gob.pe,admin.dra.gob.pe

# === CORS ===
# Configurar en config/cors.php los dominios permitidos

# === RATE LIMITING ===
# Configurar en config/sanctum.php los límites

# === TERCEROS (Opcional) ===
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# === MONITOREO (Opcional) ===
# SENTRY_LARAVEL_DSN=https://xxx@sentry.io/xxx
# BUGSNAG_API_KEY=xxx

# === BACKUP (Opcional) ===
# BACKUP_DISK=s3
# BACKUP_NOTIFICATION_EMAIL=admin@dra.gob.pe

# ============================================
# INSTRUCCIONES:
# ============================================
# 1. Copiar este archivo: cp .env.production.example .env
# 2. Generar APP_KEY: php artisan key:generate
# 3. Generar JWT_SECRET: php artisan jwt:secret
# 4. Actualizar todas las contraseñas y secretos
# 5. Configurar Redis/Memcached si está disponible
# 6. Configurar S3 para almacenamiento (opcional)
# 7. Verificar permisos: chmod 600 .env
# 8. NO commitear .env al repositorio
# ============================================
